# Build outputs (one directory per task)
build-*/
*.o
*.d
*.a
*.elf
*.bin
*.hex
*.map

# Serial capture logs: only the working copies in the repo root are ignored.
# The patterns are root-anchored on purpose - evidence/ holds the archived
# copies that must stay tracked, so a bare "bt-*.log" would swallow them too.
/bt-*.log
/key-capture*.log

# Editor / OS
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini
